{
  "repository": "mattiasploesch-cpu/mtztool",
  "owner": "mattiasploesch-cpu",
  "description": "Source of truth for repository access. Checked by scripts/audit-access.sh and applied by scripts/setup-github.sh.",
  "require_two_factor": true,
  "protected_branches": [
    "main"
  ],
  "release_environment": "release",
  "roles": {
    "admin": [
      "mattiasploesch-cpu"
    ],
    "maintain": [],
    "write": [],
    "triage": [],
    "read": []
  },
  "repository_settings": {
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_auto_merge": true,
    "delete_branch_on_merge": true,
    "allow_update_branch": true,
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "audit": {
    "inactive_days_before_review": 90,
    "inactive_days_before_downgrade": 180,
    "secret_max_age_days": 90
  }
}
